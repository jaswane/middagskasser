# Only set public indexing after the launch checklist is complete.
NEXT_PUBLIC_SITE_URL=https://middagskasser.no
NEXT_PUBLIC_INDEXABLE=false
# Optional; no analytics request is sent until consent is accepted.
NEXT_PUBLIC_GA_ID=
# Set verified, HTTPS Adtraction tracking URLs; blank means ordinary provider links.
HELLOFRESH_AFFILIATE_URL=
GODTLEVERT_AFFILIATE_URL=

# Confirmed legal name and organisation number, displayed in privacy notice.
PRIVACY_CONTROLLER=
# Reviewed paragraph: host, email/data processors, regions, logs, purposes,
# legal bases, retention and any non-EEA transfers/safeguards (including Google).
PRIVACY_OPERATIONS=
# Reviewed retention and legal basis for contact email.
PRIVACY_CONTACT_RETENTION=
# Must match GA4 admin setting. Disable reset on new activity.
GA_RETENTION_MONTHS=
# Set only after real-host QA, real partner redirects and GA4 DebugView checks.
# Also verify partner asset rights and data-processing agreements.
LAUNCH_VERIFIED=false
