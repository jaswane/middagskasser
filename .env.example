# Only set public indexing after the launch checklist is complete.
NEXT_PUBLIC_SITE_URL=https://middagskasser.no
NEXT_PUBLIC_INDEXABLE=false
# Optional. Blank means no analytics, no consent banner and no Google script.
# A set value must be a valid GA4 ID and needs GA_RETENTION_MONTHS.
NEXT_PUBLIC_GA_ID=
# Optional. Blank uses the approved eButikker.no fallback; a set value must be a
# verified HTTPS Adtraction tracking URL or the launch gate reports NO-GO.
HELLOFRESH_AFFILIATE_URL=
GODTLEVERT_AFFILIATE_URL=

# Reviewed paragraph: host (Vercel), data processors, regions, logs, purposes,
# legal bases, retention and any non-EEA transfers/safeguards (including Google).
PRIVACY_OPERATIONS=
# Reviewed retention and legal basis for contact email.
PRIVACY_CONTACT_RETENTION=
# Only when NEXT_PUBLIC_GA_ID is set. Must match GA4 admin setting.
# Disable reset on new activity.
GA_RETENTION_MONTHS=
# Set only after real-host QA, real partner redirects and GA4 DebugView checks.
# Also verify partner asset rights and data-processing agreements.
LAUNCH_VERIFIED=false
